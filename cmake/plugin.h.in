#pragma once

#include <string_view>

#include <REL/Relocation.h>

// Project metadata consumed through src/pch.h (generated at build time).
// Identity: "CharacterPanel" (mainline since 2026-10-05, promoted from the
// validated CharacterPanelProto prototype). The SKSE plugin name, log file,
// evidence TGA directory and MO2 deployment path are all keyed on it
// (docs/m0-handoff.md runbook).
#define PLUGIN_NAMESPACE @PROJECT_NAMESPACE@
#define PLUGIN_NAMESPACE_BEGIN namespace PLUGIN_NAMESPACE {
#define PLUGIN_NAMESPACE_END }

namespace Plugin
{
    inline constexpr REL::Version Plugin_Version{
        @PROJECT_VERSION_MAJOR@u,
        @PROJECT_VERSION_MINOR@u,
        @PROJECT_VERSION_PATCH@u,
    };

    inline constexpr std::string_view Plugin_Name = "@PROJECT_NAME@";
    inline constexpr std::string_view Plugin_Author = "@PROJECT_AUTHOR@";

    // One-line build provenance for the load banner (our extension to the
    // template metadata; not consumed by SKSE). The experiment branch is
    // generated per configure from the probe revision and both source
    // baselines, so two probe rounds cannot share a banner; the package
    // manifest carries the same string and the packaging step checks the DLL.
#if CHARACTER_PANEL_SCENE_COPY_EXPERIMENT
    inline constexpr std::string_view Plugin_Build_Identity = "@CHARACTER_PANEL_BUILD_IDENTITY@";
#else
    inline constexpr std::string_view Plugin_Build_Identity = "CharacterPanel-m0-v6_70-mainline-2026-10-05";
#endif
}
